# HTTP port for the records API. Intake uses 3001; this app uses 3002 so both can run.
PORT=3002

# libsql/Turso-compatible SQLite URL. Relative paths are resolved from apps/api.
# This database is only for records-admin. It is not the intake-form database.
DATABASE_URL=file:./data/records.db

# Directory for uploaded images. Relative paths are resolved from apps/api.
UPLOAD_DIR=./data/uploads

# Browser origin allowed to call the API directly (the Vite dev server proxies /api).
WEB_ORIGIN=http://localhost:5174

# Single admin account. Copy this file to .env before starting the app.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Signs the admin session cookie. If unset, the API generates one at startup and
# existing sessions end when the process restarts.
SESSION_SECRET=replace-with-a-long-random-string

# Bearer token for the local worker API. The admin cookie cannot call those
# routes, and this token cannot open the admin UI. If unset, the worker API
# stays closed.
WORKER_TOKEN=replace-with-long-random-worker-token
